tools := "go tool -modfile=tools/go.mod"

list:
    just --list

# Fetch the module specs of renku-data-services listed in cmd/fetchspecs at <ref> and regenerate the API clients
update-spec ref:
    go run ./cmd/fetchspecs -ref {{ref}}
    go generate ./internal/renkuapi/...

test:
    go test -race ./...

lint:
    {{tools}} golangci-lint run ./...

vulncheck:
    {{tools}} govulncheck ./...

build target="bin" version="dev":
    CGO_ENABLED=0 go build -trimpath -ldflags "-s -w -X main.version={{version}}" -o {{target}}/mcp-server ./cmd/mcp-server

# Serve over stdio against a Renku deployment, e.g. just run-stdio https://renku.example.org/api/data
run-stdio api_url:
    RENKU_API_URL={{api_url}} go run ./cmd/mcp-server --stdio
